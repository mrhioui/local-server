{
  "servers": [
    {
      "host": "127.0.0.1",
      "ports": [8080, 8081],
      "server_names": ["localhost"],
      "default_server": true,
      "max_body_size": 10485760,
      "error_pages": {
        "400": "error_pages/400.html",
        "403": "error_pages/403.html",
        "404": "error_pages/404.html",
        "405": "error_pages/405.html",
        "413": "error_pages/413.html",
        "500": "error_pages/500.html"
      },
      "routes": [
        { "path": "/", "root": "www", "methods": ["GET"],
          "default_file": "index.html", "autoindex": false },
        { "path": "/uploads", "root": "www/uploads",
          "methods": ["GET", "POST", "DELETE"], "autoindex": true,
          "upload_dir": "www/uploads" },
        { "path": "/old", "redirect": "/", "redirect_code": 301 }
      ]
    },
    {
      "host": "127.0.0.1",
      "ports": [8080],
      "server_names": ["test.com"],
      "routes": [
        { "path": "/", "root": "www/site2", "default_file": "index.html" }
      ]
    }
  ]
}